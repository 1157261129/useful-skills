#!/usr/bin/env bash

set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_SOURCE%/*}"
if [[ "${SCRIPT_DIR}" == "${SCRIPT_SOURCE}" ]]; then
  SCRIPT_DIR="."
fi
CLI_PATH="${SCRIPT_DIR}/tool-catalog.mjs"

if ! command -v node >/dev/null 2>&1; then
  echo "Tool Catalog CLI environment error: missing required runtime dependency 'node'. Install Node.js 18 or newer and retry." >&2
  exit 127
fi

exec node "${CLI_PATH}" "$@"
